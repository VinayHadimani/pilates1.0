// Arcwave Pilates — Prisma schema (MySQL)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Admin account (password-protected /admin panel)
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Dynamic membership / pricing plans (editable in admin)
model PricingPlan {
  id             String   @id @default(cuid())
  name           String  
  /// "membership" | "daily" | "trial"
  type           String   @default("membership")
  /// Membership duration in months (1, 3, 6). 0 for non-membership.
  durationMonths Int      @default(0)
  /// "twice" | "thrice" | "unlimited" | "" — classes per week option
  frequency      String   @default("")
  classesPerWeek Int      @default(0)
  totalClasses   Int      @default(0)
  /// Bonus classes granted on purchase
  bonusClasses   Int      @default(0)
  /// Max classes allowed to carry forward
  carryForward   Int      @default(0)
  price          Float
  currency       String   @default("INR")
  oldPrice       Float?
  /// Short marketing line
  tagline        String? 
  /// Features, newline separated
  features       String? 
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type, isActive, sortOrder])
}

/// Weekly class schedule slots (for daily booking)
model ClassSlot {
  id        String   @id @default(cuid())
  /// 0 = Sunday ... 6 = Saturday
  dayOfWeek Int
  /// "07:00"
  startTime String  
  endTime   String? 
  className String   @default("Reformer Pilates")
  capacity  Int      @default(6)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayOfWeek, isActive])
}

/// A booking made by a visitor (trial / daily / membership request)
model Booking {
  id        String   @id @default(cuid())
  /// "trial" | "daily" | "membership"
  type      String  
  name      String  
  phone     String  
  email     String? 
  /// goal / message for trial
  goal      String? 
  planId    String? 
  slotId    String? 
  /// ISO date "yyyy-MM-dd"
  date      String? 
  slotLabel String? 
  /// "pending" | "confirmed" | "cancelled" | "rescheduled" | "completed"
  status    String   @default("pending")
  notes     String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([date])
}

/// Active membership (calendar locked)
model Membership {
  id             String   @id @default(cuid())
  name           String  
  phone          String  
  email          String? 
  planId         String  
  planName       String  
  startDate      String  
  endDate        String  
  classesPerWeek Int
  totalClasses   Int
  usedClasses    Int      @default(0)
  bonusClasses   Int      @default(0)
  carryForward   Int      @default(0)
  /// JSON array of locked weekly slots, stored as LongText.
  /// Kept as a string (not Prisma Json) so the existing JSON.parse/stringify code is unchanged.
  lockedDates    String   @default("[]")
  /// "active" | "expired" | "cancelled" | "paused"
  status         String   @default("active")
  bookingId      String? 
  notes          String? 
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

/// Key/value site settings (insta link, trial link, studio info) — dynamic
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// Certifications / qualifications (admin-managed, shown on public site)
model Certificate {
  id          String   @id @default(cuid())
  title       String
  issuer      String
  /// Year issued, e.g. "2019" or "2019 – 2022"
  year        String
  /// Optional short description
  description String?
  /// Optional image / badge URL
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}
