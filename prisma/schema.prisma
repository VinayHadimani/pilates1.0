// Arcwave Pilates — Prisma schema (MySQL)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Admin account (password-protected /admin panel)
model AdminUser {
  id           String   @id @default(cuid()) @db.VarChar(30)
  username     String   @unique @db.VarChar(80)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Dynamic membership / pricing plans (editable in admin)
model PricingPlan {
  id             String   @id @default(cuid()) @db.VarChar(30)
  name           String   @db.VarChar(200)
  /// "membership" | "daily" | "trial"
  type           String   @default("membership") @db.VarChar(20)
  /// Membership duration in months (1, 3, 6). 0 for non-membership.
  durationMonths Int      @default(0)
  /// "twice" | "thrice" | "unlimited" | "" — classes per week option
  frequency      String   @default("") @db.VarChar(20)
  classesPerWeek Int      @default(0)
  totalClasses   Int      @default(0)
  /// Bonus classes granted on purchase
  bonusClasses   Int      @default(0)
  /// Max classes allowed to carry forward
  carryForward   Int      @default(0)
  price          Float
  currency       String   @default("INR") @db.VarChar(10)
  oldPrice       Float?
  /// Short marketing line
  tagline        String?  @db.VarChar(200)
  /// Features, newline separated
  features       String?  @db.Text
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type, isActive, sortOrder])
}

/// Weekly class schedule slots (for daily booking)
model ClassSlot {
  id        String   @id @default(cuid()) @db.VarChar(30)
  /// 0 = Sunday ... 6 = Saturday
  dayOfWeek Int
  /// "07:00"
  startTime String   @db.VarChar(10)
  endTime   String?  @db.VarChar(10)
  className String   @default("Reformer Pilates") @db.VarChar(100)
  capacity  Int      @default(6)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayOfWeek, isActive])
}

/// A booking made by a visitor (trial / daily / membership request)
model Booking {
  id        String   @id @default(cuid()) @db.VarChar(30)
  /// "trial" | "daily" | "membership"
  type      String   @db.VarChar(20)
  name      String   @db.VarChar(200)
  phone     String   @db.VarChar(40)
  email     String?  @db.VarChar(200)
  /// goal / message for trial
  goal      String?  @db.VarChar(500)
  planId    String?  @db.VarChar(30)
  slotId    String?  @db.VarChar(30)
  /// ISO date "yyyy-MM-dd"
  date      String?  @db.VarChar(20)
  slotLabel String?  @db.VarChar(200)
  /// "pending" | "confirmed" | "cancelled" | "rescheduled" | "completed"
  status    String   @default("pending") @db.VarChar(20)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([date])
}

/// Active membership (calendar locked)
model Membership {
  id             String   @id @default(cuid()) @db.VarChar(30)
  name           String   @db.VarChar(200)
  phone          String   @db.VarChar(40)
  email          String?  @db.VarChar(200)
  planId         String   @db.VarChar(30)
  planName       String   @db.VarChar(200)
  startDate      String   @db.VarChar(20)
  endDate        String   @db.VarChar(20)
  classesPerWeek Int
  totalClasses   Int
  usedClasses    Int      @default(0)
  bonusClasses   Int      @default(0)
  carryForward   Int      @default(0)
  /// JSON array of locked weekly slots, stored as LongText.
  /// Kept as a string (not Prisma Json) so the existing JSON.parse/stringify code is unchanged.
  lockedDates    String   @default("[]") @db.LongText
  /// "active" | "expired" | "cancelled" | "paused"
  status         String   @default("active") @db.VarChar(20)
  bookingId      String?  @db.VarChar(30)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

/// Key/value site settings (insta link, trial link, studio info) — dynamic
model Setting {
  id        String   @id @default(cuid()) @db.VarChar(30)
  key       String   @unique @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
